# Set this to the origin where your FastAPI backend runs.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Endpoint used for upload + analysis. Must accept multipart/form-data with field "file".
VITE_ANALYZE_ENDPOINT=/api/analyze
# Optional endpoint that returns a previously analyzed track list.
VITE_LIBRARY_ENDPOINT=/api/songs